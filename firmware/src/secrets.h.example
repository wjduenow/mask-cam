// secrets.h.example — copy to secrets.h and fill in. secrets.h is gitignored.
//
//   cp src/secrets.h.example src/secrets.h && $EDITOR src/secrets.h
//
// Nothing else in the firmware knows your network, so this is the only file
// that ever has to stay out of the repository.
#pragma once

#define WIFI_SSID  "your-network"
#define WIFI_PASS  "your-password"

// Optional. Leave as-is unless the mask should answer to a different name.
// #define MC_HOSTNAME "mask-cam"

// STRONGLY recommended once the mask is on a shared network: without it,
// anyone who can reach the device can replace its firmware. Applies to both
// the espota upload and the web /update form.
#define OTA_PASSWORD "change-me"
