# Python
__pycache__/
*.pyc

# the bundled skill ships without its own history or caches
.claude/skills/*/.git/
.claude/skills/*/__pycache__/

# Regenerable by build_all.py --force from Sri_Lankan_Mask_2.3mf, and far too big to
# version: the mask alone is 50 MB of ASCII triangles.  The donor 3MF and mask_cam.3mf
# ARE tracked -- the donor because nothing rebuilds without it, and mask_cam.3mf because
# it is the geometry that was physically printed, in a form 3x smaller than the STL.
mask_raw.stl
mask_cam.stl
mask_cam_asprinted.stl

# Sampled surface grids -- rebuilt by the analyze_*.py stages
*.npz

# Sri_Lankan_Mask_2.3mf, unzipped -- 89 MB of XML that `unzip Sri_Lankan_Mask_2.3mf -d
# extracted` reproduces exactly.  The archive is tracked; its expansion is not.
extracted/

# ═══════════════════════════════════════════════════════════════════════════════
# THE DONOR MODEL IS NOT REDISTRIBUTABLE, and is therefore not in this repository.
#
#   Sri Lankan Mask (Gini Raksha), by Tbridge3D
#   Standard Digital File License -- print for yourself, do not re-upload.
#
# Everything here is built FROM it and none of it can be built without it.  Buy or
# download your own copy, drop it in beside these scripts under the name below, and
# `python build_all.py --force` will regenerate every derived file.  mask_cam.3mf is
# excluded for the same reason: it carries the donor's geometry unchanged.
Sri_Lankan_Mask_2.3mf
mask_cam.3mf

